{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-video-bf16",
  "name": "H3 Video BF16",
  "section": "video",
  "summary": "A clip with its own sound from a prompt, on the full-base BF16 MiniMax H3. Unquantised DiT, BF16 encoder on CPU.",
  "higgsfield_feature": "Create Video",
  "pack": "video-h3-bf16",
  "status": "draft",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_t2v.json",
    "comfyui": "0.42.0",
    "notes": "Comfy's video_minimax_h3_t2v template retargeted to the original BF16 DiT, the BF16 Qwen3-VL-32B encoder on CPU, and the FP16 video and FP32 audio VAEs. Plain 20-step turbo branch is not used; reference-50 is the acceptance preset."
  },
  "inputs": [
    {
      "id": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "required": true,
      "default": "A street cook in Mexico City flips tacos on a hot griddle, steam and sizzling sound, he looks up and says: \"Two more coming right up!\"",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "140:131",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "aspect",
      "type": "select",
      "label": "Format",
      "default": "16:9 (Widescreen)",
      "options": [
        {
          "value": "16:9 (Widescreen)",
          "label": "16:9"
        },
        {
          "value": "9:16 (Portrait Widescreen)",
          "label": "9:16"
        },
        {
          "value": "1:1 (Square)",
          "label": "1:1"
        },
        {
          "value": "4:3 (Standard)",
          "label": "4:3"
        }
      ],
      "bind": [
        {
          "node": "115",
          "field": "aspect_ratio"
        }
      ]
    },
    {
      "id": "resolution",
      "type": "select",
      "label": "Resolution",
      "default": 0.98,
      "help": "Native is the model training size, 1344x768 at 16:9. Fast is the lighter template default.",
      "options": [
        {
          "value": 0.4,
          "label": "Fast 864x480 (0.4 MP)"
        },
        {
          "value": 0.98,
          "label": "Native 1344x768 (0.98 MP)"
        }
      ],
      "bind": [
        {
          "node": "115",
          "field": "megapixels"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "bind": [
        {
          "node": "140:133",
          "field": "value"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 50,
      "help": "Fewer steps run faster and look rougher.",
      "bind": [
        {
          "node": "140:137",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "140:129",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_bf16.safetensors",
      "dir": "diffusion_models",
      "gb": 66.28,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_bf16.safetensors",
      "dir": "text_encoders",
      "gb": 51.51,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_fp16.safetensors",
      "dir": "vae",
      "gb": 5.21,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "MiniMax H3 (MiniMax H3 Community License)"
  ],
  "test": {
    "prompt": "a cat yawns on a sunny windowsill",
    "duration": 2
  },
  "presets": [
    {
      "id": "reference-50",
      "label": "Reference (50 steps, Euler)",
      "sets": [
        {
          "node": "140:123",
          "field": "sampler_name",
          "value": "euler"
        },
        {
          "node": "140:137",
          "field": "value",
          "value": 50
        }
      ]
    },
    {
      "id": "reference-49",
      "label": "Reference parity (49 steps)",
      "sets": [
        {
          "node": "140:123",
          "field": "sampler_name",
          "value": "euler"
        },
        {
          "node": "140:137",
          "field": "value",
          "value": 49
        }
      ]
    },
    {
      "id": "freefield-50",
      "label": "Freefield native (50 steps, res_multistep)",
      "sets": [
        {
          "node": "140:123",
          "field": "sampler_name",
          "value": "res_multistep"
        },
        {
          "node": "140:137",
          "field": "value",
          "value": 50
        }
      ]
    }
  ]
}
