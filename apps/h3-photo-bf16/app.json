{
  "$schema": "../../schema/app.schema.json",
  "id": "h3-photo-bf16",
  "name": "H3 Photo BF16",
  "section": "video",
  "summary": "Animate a photo on the full-base BF16 MiniMax H3, with sound. Unquantised DiT, BF16 encoder on CPU.",
  "higgsfield_feature": "Create Video",
  "pack": "video-h3-bf16",
  "status": "draft",
  "workflow": "workflow.api.json",
  "source": {
    "template": "video_minimax_h3_i2v.json",
    "comfyui": "0.42.0",
    "notes": "h3-photo retargeted to the original BF16 DiT, BF16 Qwen3-VL-32B encoder on CPU, FP16 video VAE and FP32 audio VAE. Resolution path left alone: ImageScaleToTotalPixels at 0.6 MP, aspect from the image."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "114",
          "field": "image"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "textarea",
      "label": "What happens",
      "required": true,
      "default": "The person smiles, waves at the camera and says: \"Hey, good to see you.\"",
      "help": "Put spoken words in quotes; describe sounds and music too.",
      "bind": [
        {
          "node": "105:104",
          "field": "prompt"
        }
      ]
    },
    {
      "id": "duration",
      "type": "slider",
      "label": "Duration (s)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "bind": [
        {
          "node": "105:111",
          "field": "value"
        }
      ]
    },
    {
      "id": "steps",
      "type": "slider",
      "label": "Steps",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 50,
      "help": "Fewer steps run faster and look rougher.",
      "bind": [
        {
          "node": "105:124",
          "field": "value"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "105:15",
          "field": "noise_seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "92",
      "type": "video",
      "label": "Video"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "diffusion_models/minimax_h3_fl2va_bf16.safetensors",
      "dir": "diffusion_models",
      "gb": 66.28,
      "phase": "denoise",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "text_encoders/qwen3vl_32b_minimax_h3_bf16.safetensors",
      "dir": "text_encoders",
      "gb": 51.51,
      "phase": "encode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_video_vae_fp16.safetensors",
      "dir": "vae",
      "gb": 5.21,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    },
    {
      "repo": "Comfy-Org/MiniMax-H3",
      "file": "vae/minimax_h3_audio_vae_fp32.safetensors",
      "dir": "vae",
      "gb": 0.61,
      "phase": "decode",
      "license": "MiniMax H3 Community License"
    }
  ],
  "credits": [
    "MiniMax H3 (MiniMax H3 Community License)"
  ],
  "test": {
    "image": "test/portrait.png",
    "prompt": "she smiles",
    "duration": 2
  },
  "presets": [
    {
      "id": "reference-50",
      "label": "Reference (50 steps, Euler)",
      "sets": [
        {
          "node": "105:17",
          "field": "sampler_name",
          "value": "euler"
        },
        {
          "node": "105:124",
          "field": "value",
          "value": 50
        }
      ]
    },
    {
      "id": "reference-49",
      "label": "Reference parity (49 steps)",
      "sets": [
        {
          "node": "105:17",
          "field": "sampler_name",
          "value": "euler"
        },
        {
          "node": "105:124",
          "field": "value",
          "value": 49
        }
      ]
    },
    {
      "id": "freefield-50",
      "label": "Freefield native (50 steps, res_multistep)",
      "sets": [
        {
          "node": "105:17",
          "field": "sampler_name",
          "value": "res_multistep"
        },
        {
          "node": "105:124",
          "field": "value",
          "value": 50
        }
      ]
    }
  ]
}
